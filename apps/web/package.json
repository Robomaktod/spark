{
  "name": "@spark/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Spark match viewer and spell workbench. Runs the engine in the browser.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
